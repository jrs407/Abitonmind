### Crear secarse despues de Ducharse.
# @name secarse
POST {{host}}/api/habitos
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
    "nombre" : "Secarse",
    "descripcion" : null,
    "preparacion" : null,
    "hora" : null,
    "dias" : 127,
    "tipo" : null,
    "habitoAntecesorId" : {{ducharse.response.body.$.id}},
    "colorHabito" : null,
    "recordatorio" : false
}

### Marcar secarse hoy sin haber marcado ducharse.
PUT {{host}}/api/habitos/{{secarse.response.body.$.id}}/registros/{{$localDatetime "YYYY-MM-DD"}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Marcar secarse ayer.
PUT {{host}}/api/habitos/{{secarse.response.body.$.id}}/registros/{{$localDatetime "YYYY-MM-DD" -1 d}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Marcar secarse el dia siguiente.
PUT {{host}}/api/habitos/{{secarse.response.body.$.id}}/registros/{{$localDatetime "YYYY-MM-DD" 1 d}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Marcar ayer un habito que no existe.
PUT {{host}}/api/habitos/9999/registros/{{$localDatetime "YYYY-MM-DD" -1 d}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Desmarcar Secarse ayer.
DELETE {{host}}/api/habitos/{{secarse.response.body.$.id}}/registros/{{$localDatetime "YYYY-MM-DD" -1 d}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Desmarcar Secarse hoy.
DELETE {{host}}/api/habitos/{{secarse.response.body.$.id}}/registros/{{$localDatetime "YYYY-MM-DD"}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Marcar hoy ordenar el trastero.
PUT {{host}}/api/habitos/{{ordenarTrastero.response.body.$.id}}/registros/{{$localDatetime "YYYY-MM-DD"}}
Authorization: Bearer {{login.response.body.$.accessToken}}


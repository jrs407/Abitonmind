### Editar meditar mandando repeticion 50.
PUT {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
    "nombre" : "Meditar",
    "descripcion" : "Un minuto respirando despacio",
    "preparacion" : "Sentarse en un sitio tranquilo",
    "colorPasoMinimo" : null,
    "repeticion" : 50
}

### Ver meditar despues de editar.
GET {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Listar habitos, meditar no sale.
GET {{host}}/api/habitos
Authorization: Bearer {{login.response.body.$.accessToken}}

### Otro usuario, ver Meditar.
GET {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}
Authorization: Bearer {{loginOtroUsuario.response.body.$.accessToken}}

### Otro usuario, sumar a Meditar.
POST {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}/sumar
Authorization: Bearer {{loginOtroUsuario.response.body.$.accessToken}}

### Archivar meditar.
DELETE {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Ver meditar archivado.
GET {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Sumar a meditar archivado.
POST {{host}}/api/pasosminimos/{{pasoMeditar.response.body.$.id}}/sumar
Authorization: Bearer {{login.response.body.$.accessToken}}

### Listar pasos minimos, meditar no sale.
GET {{host}}/api/pasosminimos
Authorization: Bearer {{login.response.body.$.accessToken}}

### Crear afeitarse despues de lavarse los dientes.
# @name afeitarse
POST {{host}}/api/habitos
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
    "nombre" : "Afeitarse",
    "descripcion" : null,
    "preparacion" : null,
    "hora" : null,
    "dias" : 5,
    "tipo" : null,
    "habitoAntecesorId" : {{lavarseDientes.response.body.$.id}},
    "colorHabito" : null,
    "recordatorio" : false
}

### Archivar levantarse.
DELETE {{host}}/api/habitos/{{levantarse.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Ver lavarse los dientes.
GET {{host}}/api/habitos/{{lavarseDientes.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Ver afeitarse.
GET {{host}}/api/habitos/{{afeitarse.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Ver hacer la cama.
GET {{host}}/api/habitos/{{hacerCama.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

